# Copy values into your IDE run configuration or OS environment; do not commit real secrets.
DB_URL=jdbc:mysql://localhost:3306/civicpulse_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGIN=http://localhost:5173
DDL_AUTO=update
SHOW_SQL=false

# Optional: set both variables once to create the first administrator on startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=CivicPulse Administrator
